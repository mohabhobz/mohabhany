    {
      "id": "cwghktr4",
      "title": "Prototype",
      "rows": [
        {
          "id": "khrpm4j3",
          "layout": "1",
          "cells": [
            [
              {
                "id": "rw1hdn6h",
                "kind": "heading",
                "level": 2,
                "text": "See it move"
              },
              {
                "id": "fojg7o4n",
                "kind": "paragraph",
                "text": "Screens do not show interaction, and this page has a lot of it: the category row reveals its copy on hover, the diagonals and running figures carry motion through the layout, and the product cards respond as you move across them. The prototype is where the energy the design is built on actually reads."
              },
              {
                "id": "8jylnelq",
                "kind": "figma",
                "src": "https://embed.figma.com/proto/ZzmAJhae18meKoB4Dq5TNI/HOBZUP?node-id=2023-1663&viewport=254%2C242%2C0.4&starting-point-node-id=2023%3A1663&page-id=2023%3A1662&embed-host=share&footer=false",
                "caption": "Prototype is view-only.",
